      "output_types": {"running": "Bool", "live": "Bool", "armed": "Bool", "published": "Bool", "source_pose": "Dict", "current_pose": "Dict", "command": "Dict", "message_stream": "Dict", "clamped": "List", "joint_count": "Int", "dashboard": "Image", "summary": "Dict", "report": "Text"},
