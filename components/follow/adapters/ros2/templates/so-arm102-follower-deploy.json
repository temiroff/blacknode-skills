  "metadata": {
    "template": true,
    "hidden": true,
    "description": "Deploy one calibrated follower to its paired hardware device. Linux deployments use the native ROS 2 graph for leader pose and follower commands. Windows local runs automatically use rosbridge. The follower stays disarmed until Armed is enabled.",
    "color": "#f59e0b",
    "required_capabilities": ["joint_group", "position_feedback", "servo_bus"],
    "required_packages": ["blacknode-skills", "blacknode-robot", "blacknode-drivers", "blacknode-motion", "blacknode-ros2"],
    "required_components": ["blacknode-skills/follow", "blacknode-robot/core", "blacknode-drivers/feetech", "blacknode-motion/arm", "blacknode-ros2/core", "blacknode-ros2/diagnostics"],
    "required_adapters": ["blacknode-skills/follow@ros2", "blacknode-drivers/feetech@ros2", "blacknode-motion/arm@ros2"],
    "deployment_pair": {"id": "so_arm_leader_follower", "role": "follower", "transport": "auto", "leader_port": 9091, "follower_port": 9090}
  },
  "node_meta": {
