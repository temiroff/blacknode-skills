        "control_topic": "/blacknode/leader_follower/so_arm_joint_publisher/control",
        "transport": "auto",
        "host": "127.0.0.1",
        "port": 9090,
        "joint_map": {},
        "scale": {},
        "offset_deg": {},
        "tracking_mode": "direct",
        "loop_hz": 60.0,
        "max_step_deg": 0.0,
        "deadband_deg": 0.0,
        "stale_after": 0.75,
