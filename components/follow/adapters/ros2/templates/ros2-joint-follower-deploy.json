{
  "kind": "blacknode.workflow",
  "schema_version": 1,
  "name": "ROS 2 Joint Follower Subscribe",
  "saved_at": "2026-07-28T00:00:00",
  "entrypoint": {
    "node_id": "out",
    "port": "value"
  },
  "metadata": {
    "template": true,
    "description": "Subscribe to sensor_msgs/msg/JointState on /leader/joint_states using native ROS 2 and expose the latest received pose.",
    "color": "#f59e0b",
    "required_packages": [
      "blacknode-skills",
      "blacknode-robot",
      "blacknode-ros2"
    ],
    "required_components": [
      "blacknode-skills/follow",
      "blacknode-robot/core",
      "blacknode-ros2/core"
    ],
    "required_adapters": [
      "blacknode-skills/follow@ros2"
    ],
    "deployment_pair": {
      "id": "ros2_joint_transport",
      "role": "subscriber",
      "transport": "native",
      "state_topic": "/leader/joint_states",
      "message_type": "sensor_msgs/msg/JointState"
    }
  },
  "node_meta": {
    "subscribe": {
      "id": "subscribe",
      "type": "ROS2JointSubscribe",
      "pos": [
        160,
        180
      ],
      "params": {
        "label": "ROS 2 Subscribe: /leader/joint_states",
        "action": "start",
        "run_id": "ros2_joint_leader_subscription",
        "transport": "native",
        "host": "127.0.0.1",
        "port": 9090,
        "state_topic": "/leader/joint_states",
        "config_topic": "/leader/joint_config",
        "stale_after": 0.75,
        "timeout": 10.0
      },
      "inputs": [
        "trigger",
        "action",
        "run_id",
        "robot",
        "transport",
        "host",
        "port",
        "state_topic",
        "config_topic",
        "stale_after",
        "timeout"
      ],
      "outputs": [
        "running",
        "live",
        "subscription",
        "sample_stream",
        "pose",
        "age",
        "report"
      ],
      "input_types": {
        "trigger": "Any",
        "action": "Text",
        "run_id": "Text",
        "robot": "Dict",
        "transport": "Text",
        "host": "Text",
        "port": "Int",
        "state_topic": "Text",
        "config_topic": "Text",
        "stale_after": "Float",
        "timeout": "Float"
      },
      "output_types": {
        "running": "Bool",
        "live": "Bool",
        "subscription": "Dict",
        "sample_stream": "Dict",
        "pose": "Dict",
        "age": "Float",
        "report": "Text"
      },
      "input_defaults": {
        "action": "start",
        "run_id": "joint_subscription",
        "transport": "auto",
        "host": "127.0.0.1",
        "port": 9090,
        "state_topic": "/leader/joint_states",
        "config_topic": "/leader/joint_config",
        "stale_after": 0.75,
        "timeout": 10.0
      },
      "input_choices": {
        "action": [
          "start",
          "stop",
          "check"
