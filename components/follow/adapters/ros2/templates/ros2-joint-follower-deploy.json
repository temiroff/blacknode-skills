  "metadata": {
    "template": true,
    "description": "Deploy a calibrated joint robot as a native ROS 2 follower. It subscribes to sensor_msgs/msg/JointState on /leader/joint_states and publishes safely clamped targets to /follower/joint_commands. Pair it with ROS 2 Joint Leader Deploy on the same ROS_DOMAIN_ID and DDS network. Motion remains disarmed until explicitly armed.",
    "color": "#f59e0b",
    "required_capabilities": [
      "joint_group",
      "position_feedback",
      "servo_bus"
    ],
    "required_packages": [
      "blacknode-skills",
      "blacknode-robot",
      "blacknode-drivers",
      "blacknode-controllers",
      "blacknode-ros2"
    ],
    "required_components": [
      "blacknode-skills/follow",
      "blacknode-robot/core",
      "blacknode-drivers/feetech",
      "blacknode-controllers/joint-control",
      "blacknode-ros2/core",
      "blacknode-ros2/diagnostics",
      "blacknode-ros2/topics"
    ],
    "required_adapters": [
      "blacknode-skills/follow@ros2",
      "blacknode-drivers/feetech@ros2",
      "blacknode-controllers/joint-control@ros2"
    ],
    "deployment_pair": {
      "id": "ros2_joint_leader_follower",
      "role": "follower",
      "transport": "native",
      "leader_state_topic": "/leader/joint_states",
      "follower_command_topic": "/follower/joint_commands",
      "message_type": "sensor_msgs/msg/JointState"
    }
